{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tracking-cv-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "DOCS_ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [{ "name": "CV_COORDINATOR", "class_name": "CvCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CvCoordinator"] }],
  "observability": { "enabled": false }
}
